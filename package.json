{
  "name": "omagari",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "format": "biome check --write",
    "format:check": "biome ci",
    "typecheck": "tsc",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.ts\" \"packages/*/src/**/*.test.ts\"",
    "server": "node packages/server/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "ws": "^8.22.2"
  }
}
