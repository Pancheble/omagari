#!/bin/sh
# 커밋 제목이 "접두사(범위): 요약" 형식인지 검사한다. 요약은 50자 안쪽, 끝에 마침표 없음.
first=$(head -n 1 "$1")
case "$first" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
fail() {
  echo "커밋 제목이 규칙에 맞지 않아요($1): $first" >&2
  echo "형식: 접두사(범위): 요약   예) feat(runner): 세션 이어 가기 추가" >&2
  echo "접두사: feat fix docs refactor test chore ci perf. 범위는 선택(소문자, 숫자, 하이픈). 요약은 50자 안쪽, 끝에 마침표 없음" >&2
  exit 1
}
printf '%s' "$first" | grep -Eq '^(feat|fix|docs|refactor|test|chore|ci|perf)(\([a-z0-9-]+\))?!?: .+' || fail "형식"
summary=${first#*: }
# 바이트가 아니라 글자 수로 센다: UTF-8의 이어지는 바이트(0x80-0xBF)를 빼고 센다.
n=$(printf '%s' "$summary" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')
[ "$n" -le 50 ] || fail "요약 ${n}자, 50자까지"
case "$summary" in *.) fail "요약 끝에 마침표" ;; esac
exit 0
