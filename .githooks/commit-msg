#!/bin/sh
# Checks that the commit subject is "prefix(scope): summary". The summary is 50 characters or fewer, with no period at the end.
first=$(head -n 1 "$1")
case "$first" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
fail() {
  echo "Commit subject does not match the rules ($1): $first" >&2
  echo "Format: prefix(scope): summary   e.g. feat(runner): add session resume" >&2
  echo "Prefixes: feat fix docs refactor test chore ci perf. The scope is optional (lowercase letters, digits, hyphens). The summary is 50 characters or fewer, with no period at the end." >&2
  exit 1
}
printf '%s' "$first" | grep -Eq '^(feat|fix|docs|refactor|test|chore|ci|perf)(\([a-z0-9-]+\))?!?: .+' || fail "format"
summary=${first#*: }
# Count characters, not bytes: skip UTF-8 continuation bytes (0x80-0xBF).
n=$(printf '%s' "$summary" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')
[ "$n" -le 50 ] || fail "summary is ${n} characters, the limit is 50"
case "$summary" in *.) fail "summary ends with a period" ;; esac
exit 0
