# 복사해서 .env로 쓴다(`cp .env.example .env`). .env는 커밋하지 않는다.
# `npm run server`가 .env를 읽는다. 이미 셸에 있는 값이 먼저다.

# 받을 GitHub 계정 목록(ADR-0043). 쉼표로 나눈다. owner 또는 owner/name.
OMAGARI_REPO=your-org,your-name/first-repo
# 기기 인증을 켠 GitHub App 또는 OAuth 앱의 Client ID(site/server.md "GitHub sign-in").
GITHUB_CLIENT_ID=
# GitHub App이면 그 slug(https://github.com/apps/<slug>). 레포가 안 보이면 App을 설치하라고 링크와 함께 알린다. OAuth 앱이면 비운다.
# GITHUB_APP_SLUG=
# 멤버가 웹을 여는 주소. 서버가 듣는 주소와 다를 때만 적는다. Fly에서는 비워 둔다.
# OMAGARI_URL=https://omagari.example.com
# 설정 창의 "소스 코드" 링크(AGPL-3.0 13조). 서버를 고쳐 돌리면 고친 포크 주소를 적는다. 비우면 Omagari 레포.
# OMAGARI_SOURCE_URL=https://github.com/omagari-dev/omagari
# 바깥에서 붙으려면 0.0.0.0. 비우면 이 기기 안에서만 듣는다.
# HOST=0.0.0.0
# PORT=3000
# OMAGARI_DB=omagari.db
# 채팅의 GIF(ADR-0044). GIPHY 개발자 키. 비우면 GIF 버튼이 없다. 프로덕션 키면 시간당 한도를 올린다(베타 키는 100).
# GIPHY_API_KEY=
# GIPHY_PER_HOUR=100

# Fly.io에 올릴 때만(README의 "Fly.io에 올리기"). Fly 앱 이름.
# FLY_APP=your-omagari
